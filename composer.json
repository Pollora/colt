{
    "name": "pollora/colt",
    "description": "Use WordPress backend with Laravel or any PHP framework",
    "homepage": "http://github.com/Pollora/colt",
    "license": "MIT",
    "authors": [
        {
            "name": "Olivier Gorzalka",
            "email": "olivier@amphibee.fr",
            "homepage": "https://amphibee.fr"
        },
        {
            "name": "Junior Grossi",
            "email": "juniorgro@gmail.com",
            "homepage": "http://jgrossi.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/filesystem": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "fakerphp/faker": "^1.19",
        "bordoni/phpass": "0.3.*",
        "thunderer/shortcode": "^0.7.3"
    },
    "require-dev": {
        "cweagans/composer-patches": "^2.0",
        "laravel/legacy-factories": "^1.0",
        "mockery/mockery": "^1.4.4",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.8",
        "pollora/harness": "^0.1.11",
        "symfony/thanks": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Pollora\\Colt\\": "src/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:wordpress": "@php -d auto_prepend_file=tests/WordPress/load.php vendor/bin/pest -c phpunit.wordpress.xml",
        "qa": "@php vendor/bin/pollora-qa check",
        "qa:fast": "@php vendor/bin/pollora-qa check --fast"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "10.x-dev"
        },
        "original-author": "Junior Grossi",
        "original-repository": "https://github.com/corcel/corcel",
        "laravel": {
            "providers": [
                "Pollora\\Colt\\Laravel\\ColtServiceProvider"
            ]
        },
        "patches": {
            "php-stubs/wordpress-stubs": {
                "Rename __ to __wp so Laravel can declare __()": "https://raw.githubusercontent.com/Pollora/framework/b26034b3306c96098f756c0ca80631a596db25c9/patches/wordpress-stubs.patch"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "pestphp/pest-plugin": true,
            "symfony/thanks": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pollora\\Colt\\Tests\\": "tests/"
        }
    }
}
